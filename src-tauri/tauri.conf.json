{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "krdiffgui",
  "version": "1.2.0",
  "identifier": "com.admin.krdiffgui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:39898",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "krdiffgui v1.2.0 by github.com@Tomkrier",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
